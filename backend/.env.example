# Copiar a .env y completar con valores reales (nunca commitear .env).
# Sin este archivo, application.yml y docker-compose.yml usan los defaults
# de dev que están hardcodeados en el código (seguros solo en localhost).

DB_URL=jdbc:postgresql://localhost:5432/frontpet
DB_NAME=frontpet
DB_USERNAME=frontpet
DB_PASSWORD=frontpet_dev_pass

# Sentry (D.8, Sprint Despliegue). Sin DSN el SDK queda inerte, no rompe nada
# en dev/test — solo hace falta completar esto para producción (D.6.2).
SENTRY_DSN=

# JWT (openssl rand -base64 48, mín. 32 caracteres). El default de
# application.yml solo es válido en dev — StartupEnvValidator exige uno
# fuerte en producción.
JWT_SECRET=
JWT_EXPIRATION=3600000

# Tenant fijo de MVP1 (single-tenant) — el sembrado en V5__seed_dev.sql.
TENANT_ID=01924ccf-0000-7000-8000-000000000001

# Admin único (seed idempotente). ⚠️ En producción NUNCA dejar admin123 —
# StartupEnvValidator corta el arranque si lo detecta.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible), presigned upload de imágenes (tarea 3.5).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=frontpet-products
R2_ENDPOINT=
R2_PUBLIC_URL=

# Resend (tarea 7.12, reset de contraseña). API key con permiso SOLO de
# envío (Sending access), nunca Full access. Sin esto, cae a
# LoggingEmailSender (dev/test escriben el email en el log).
RESEND_API_KEY=
RESEND_FROM=FrontPet <nao-responda@frontpet.com.br>

# URL pública del frontend, para armar el link de reset de contraseña.
# ⚠️ En producción debe empezar con https:// — StartupEnvValidator corta el
# arranque si no.
APP_BASE_URL=http://localhost:3000

# CORS — en producción, el dominio real del frontend (nunca *).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Domain de la cookie de sesión (ADR 004). Vacío en dev (front/back
# comparten host `localhost`). En producción, el dominio raíz sin protocolo
# ni subdominio: `frontpet.com.br` (no `api.frontpet.com.br` ni
# `https://frontpet.com.br`) — así la comparten front y back.
COOKIE_DOMAIN=
