# URL pública del backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL pública del sitio (metadataBase, OG, canonical) — usada en app/layout.tsx
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Meta Pixel ID (completar cuando FrontPet lo provea, Sprint 8 — ver
# docs/preguntas-cliente.md §7.5). Sin este valor, <MetaPixel/> no renderiza
# nada aunque el usuario acepte el banner LGPD (ver ADR 024).
NEXT_PUBLIC_META_PIXEL_ID=

# Dominio registrado en Plausible (plausible.io). Cookieless, no pasa por el
# gate de consentimiento (ver ADR 024) — sin este valor no se carga el script.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# WhatsApp comercial (sin el +, ejemplo: 59899000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# API key de Google Places (server-only, NUNCA con prefijo NEXT_PUBLIC_) —
# usada por lib/google-places.ts para traer reviews reales del negocio.
# Restringirla en Google Cloud Console a la Places API. Ver ADR 025.
GOOGLE_PLACES_API_KEY=

# API key de Maps Embed API — se usa en el src del iframe de <LocationMap>,
# por lo tanto es pública igual (sale en el HTML). Restringirla por HTTP
# referrer al dominio del sitio en Google Cloud Console, no por ocultamiento.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Place ID de FrontPet en Google Business. No es secreto (sale en el HTML
# del iframe), se resuelve una sola vez a mano con la Places API (Find
# Place) y queda fijo acá — no se resuelve por query en cada request.
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Sentry (D.8, Sprint Despliegue). DSN de Sentry no es secreto (viaja en
# claro al browser en cualquier setup, por diseño de Sentry) — de ahí el
# prefijo NEXT_PUBLIC_. Sin este valor el SDK queda inerte, no rompe nada.
NEXT_PUBLIC_SENTRY_DSN=

# Solo necesarias en el build de producción, para subir source maps — sin
# SENTRY_AUTH_TOKEN el build sigue andando, solo salta ese paso con un warning.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
