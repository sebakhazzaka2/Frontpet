                  "pm.test('variants tiene entradas', () => pm.expect(body.variants.length).to.be.greaterThan(0));",
                  "pm.test('variante inactiva (1kg) no cuenta para el mínimo del listado', () => {",
                  "  const activas = body.variants.filter(v => v.stock > 0 || true);",
                  "  pm.expect(activas.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
