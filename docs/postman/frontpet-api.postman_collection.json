                  "const body = pm.response.json();",
                  "pm.test('shape de PageResponse', () => {",
                  "  pm.expect(body).to.have.all.keys('items','page','size','totalItems','totalPages','hasNext');",
                  "});",
                  "pm.test('9 activos del seed (ajustar si cambió)', () => pm.expect(body.totalItems).to.eql(9));"
