              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=2",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "GET /products?size=100000 (tope duro esperado: cap a 100)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('size cappeado a 100, no 100000', () => pm.expect(pm.response.json().size).to.eql(100));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?size=100000",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "size", "value": "100000" }]
            }
          }
        },
        {
          "name": "GET /products/{slug} — producto simple",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('price no es null (sin variantes)', () => pm.expect(body.price).to.not.be.null);",
                  "pm.test('variants vacío', () => pm.expect(body.variants).to.have.lengthOf(0));"
