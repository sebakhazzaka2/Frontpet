    {
      "name": "3. Admin — sin login (401 esperado)",
      "item": [
        {
          "name": "POST /admin/products sin cookie",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401, no 403 (ver fix del backend)', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Producto sin auth\",\n  \"price\": 10.00,\n  \"stock\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/admin/products", "host": ["{{baseUrl}}"], "path": ["admin", "products"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin — Produtos (requiere Login primero)",
      "item": [
        {
          "name": "POST /admin/products — simple, sin variantes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('publicIdCreado', body.publicId);",
                  "pm.collectionVariables.set('slugCreado', body.slug);",
                  "pm.test('slug autogenerado desde nome (prefijo, no exacto: slugs de corridas previas no se liberan al soft-deletear)', () => {",
                  "  pm.expect(body.slug).to.match(/^produto-de-teste-postman(-\\d+)?$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto de Teste Postman\",\n  \"descricao\": \"Criado via collection, para validar o CRUD admin\",\n  \"mainImageUrl\": null,\n  \"price\": 49.90,\n  \"stock\": 10,\n  \"brandNome\": \"Marca Teste\",\n  \"categorySlugs\": [\"outros\"],\n  \"speciesSlugs\": [\"caes\"],\n  \"variants\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/products", "host": ["{{baseUrl}}"], "path": ["admin", "products"] }
          }
        },
        {
          "name": "POST /admin/products — sin price ni variantes (400 esperado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('400 — la invariante cruzada vive en el service, no en @Valid', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto sin precio ni variantes\",\n  \"variants\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/products", "host": ["{{baseUrl}}"], "path": ["admin", "products"] }
          }
        },
        {
          "name": "POST /admin/products — con variantes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('price null cuando hay variantes', () => pm.expect(body.price).to.be.null);",
                  "pm.test('2 variantes creadas', () => pm.expect(body.variants).to.have.lengthOf(2));",
                  "pm.collectionVariables.set('publicIdConVariantes', body.publicId);",
                  "if (body.variants.length) pm.collectionVariables.set('variantIdCreado', body.variants[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto Teste Com Variantes\",\n  \"descricao\": \"Para validar price=null quando hasVariants\",\n  \"categorySlugs\": [\"racoes\"],\n  \"speciesSlugs\": [\"caes\"],\n  \"variants\": [\n    { \"nomeVariante\": \"1kg\", \"price\": 19.90, \"stock\": 5 },\n    { \"nomeVariante\": \"3kg\", \"price\": 49.90, \"stock\": 5 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/products", "host": ["{{baseUrl}}"], "path": ["admin", "products"] }
          }
        },
        {
          "name": "PUT /admin/products/{publicId} — edición completa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('precio actualizado', () => pm.expect(pm.response.json().price).to.eql(59.90));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto de Teste Postman (editado)\",\n  \"descricao\": \"Descrição editada\",\n  \"mainImageUrl\": null,\n  \"price\": 59.90,\n  \"stock\": 8,\n  \"brandNome\": \"Marca Teste\",\n  \"categorySlugs\": [\"outros\"],\n  \"speciesSlugs\": [\"caes\", \"gatos\"],\n  \"slug\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{publicIdCreado}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{publicIdCreado}}"]
            }
          }
        },
        {
          "name": "PUT /admin/products/{publicId}/variants — upsert (1 nueva + 1 update, 3kg omitida se soft-deletea)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const nomes = body.variants.map(v => v.nomeVariante).sort();",
                  "pm.test('exactamente 2 variantes activas (3kg omitida quedó soft-deleted, toDetail() filtra inactivas)', () => {",
                  "  pm.expect(body.variants).to.have.lengthOf(2);",
                  "});",
                  "pm.test('1kg quedó actualizado', () => pm.expect(nomes).to.include('1kg (atualizado)'));",
                  "pm.test('5kg se creó', () => pm.expect(nomes).to.include('5kg (nova)'));",
                  "pm.test('3kg ya no aparece (soft-deleted, no hard-delete)', () => pm.expect(nomes).to.not.include('3kg'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"id\": {{variantIdCreado}}, \"nomeVariante\": \"1kg (atualizado)\", \"price\": 21.90, \"stock\": 3 },\n  { \"id\": null, \"nomeVariante\": \"5kg (nova)\", \"price\": 79.90, \"stock\": 2 }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{publicIdConVariantes}}/variants",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{publicIdConVariantes}}", "variants"]
            }
          }
        },
        {
          "name": "DELETE /admin/products/{publicId} — soft delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "{{jwtCookie}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{publicIdCreado}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{publicIdCreado}}"]
            }
          }
        },
        {
          "name": "GET /products/{slug del creado} después del delete (404 esperado)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('404 — soft-deleted no aparece en público', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{slugCreado}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{slugCreado}}"]
            },
            "description": "Usa el slug real devuelto por el create, no uno hardcodeado — UpdateProductRequest.slug=null significa 'no tocar el slug actual' (ver javadoc del DTO), así que sigue siendo el de la creación, no '...-editado'."
          }
        },
        {
          "name": "DELETE /admin/products/{publicIdConVariantes} — limpieza (sin esto la colección no es idempotente)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "{{jwtCookie}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/products/{{publicIdConVariantes}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "{{publicIdConVariantes}}"]
            },
            "description": "Sin este delete, cada corrida deja un producto 'con variantes' vivo en la categoría Rações — los conteos hardcodeados de la sección 2 (9 activos, 2 en Rações) van a ir subiendo en cada corrida sucesiva."
          }
        }
      ]
    },
