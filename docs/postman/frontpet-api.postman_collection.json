          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "GET /products?categoria=racoes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
