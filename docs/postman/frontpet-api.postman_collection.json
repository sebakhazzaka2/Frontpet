              "raw": "{{baseUrl}}/products/{{slugConVariantes}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{slugConVariantes}}"]
            }
          }
        },
        {
          "name": "GET /products/produto-que-nao-existe (404 esperado)",
          "event": [
            {
