          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "{{jwtCookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"foto-grande.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"contentLength\": 6291456\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/products/images/presign", "host": ["{{baseUrl}}"], "path": ["admin", "products", "images", "presign"] }
          }
        },
        {
          "name": "PUT directo a uploadUrl (fuera de Postman, ver descripción)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "image/jpeg" }],
            "body": { "mode": "file" },
            "url": { "raw": "{{uploadUrlManual}}", "host": ["{{uploadUrlManual}}"] },
            "description": "Copiá el `uploadUrl` de la respuesta del presign válido de arriba, pegalo en la URL, adjuntá un JPG real de <5MB en el body (binary) y mandá el PUT. Si responde 200/OK, la foto quedó en el bucket real — recién ahí `publicUrl` sirve como `mainImageUrl` en un create/update."
          }
        }
      ]
    }
  ]
}
