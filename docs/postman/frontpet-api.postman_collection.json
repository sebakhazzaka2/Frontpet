{
  "info": {
    "name": "FrontPet API — Sprint 3 (catálogo + admin + R2)",
    "description": "Cobertura manual de los endpoints de Sprint 3. Complementa (no reemplaza) ./mvnw test — esto es para probar contra datos reales del seed-dev, no para CI.\n\n⚠️ ADR 004: la cookie de sesión se marca Secure siempre, incluso en dev. Contra http://localhost:8080 (sin túnel HTTPS), el manejo automático de cookies de Postman puede no persistirla entre requests. La request de Login ya trae un script que la guarda a mano en {{jwtCookie}} y las requests de Admin la mandan explícita en el header Cookie — no dependas del cookie jar automático.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "adminEmail", "value": "admin@frontpet.dev" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "jwtCookie", "value": "" },
    { "key": "slugSimples", "value": "bifinho-de-frango" },
    { "key": "slugConVariantes", "value": "racao-golden-formula-frango-e-carne-adulto" },
    { "key": "publicIdCreado", "value": "" },
    { "key": "slugCreado", "value": "" },
    { "key": "publicIdConVariantes", "value": "" },
    { "key": "variantIdCreado", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "pm.test('trae Set-Cookie', () => pm.expect(setCookie).to.not.be.null);",
                  "if (setCookie) {",
                  "  const match = setCookie.match(/frontpet_session=([^;]+)/);",
                  "  if (match) pm.collectionVariables.set('jwtCookie', 'frontpet_session=' + match[1]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login con password incorrecta (401 esperado)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"password-incorrecta\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "{{jwtCookie}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Público (sin auth)",
      "item": [
        {
          "name": "GET /products (default)",
          "event": [
