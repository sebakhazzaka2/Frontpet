# ═══════════════════════════════════════════════════════════
# FRONTPET MONOREPO — .gitignore
# Cubre backend (Spring Boot) y frontend (Next.js)
# ═══════════════════════════════════════════════════════════

# ─── Secretos y variables de entorno ───────────────────────
# NUNCA commitear archivos con secretos
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
**/application-local.yml
**/application-local.properties
**/application-secrets.yml
*.pem
*.key

# Mantener los ejemplos
!.env.example
!**/.env.example

# ═══════════════════════════════════════════════════════════
